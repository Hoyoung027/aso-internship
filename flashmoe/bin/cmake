#!/bin/bash
# Experiment-local compatibility wrapper for FlashMoE on SM90+ GPUs.

set -euo pipefail

REAL_CMAKE=${FLASHMOE_REAL_CMAKE:-/home/hybyun0207/miniconda3/envs/flashmoe/bin/cmake}
if [[ ! -x "$REAL_CMAKE" ]]; then
  echo "Missing real CMake executable: $REAL_CMAKE" >&2
  exit 1
fi

rewritten_args=()
for argument in "$@"; do
  if [[ "$argument" =~ ^-DCMAKE_CUDA_ARCHITECTURES=([0-9]+)$ ]]; then
    architecture=${BASH_REMATCH[1]}
    if (( architecture >= 90 )); then
      rewritten="-DCMAKE_CUDA_ARCHITECTURES=${architecture}a"
      echo "FlashMoE SM compatibility: $argument -> $rewritten" >&2
      argument=$rewritten
    fi
  fi
  rewritten_args+=("$argument")
done

exec "$REAL_CMAKE" "${rewritten_args[@]}"
